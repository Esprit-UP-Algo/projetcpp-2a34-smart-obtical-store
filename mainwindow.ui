    <property name="styleSheet">
     <string notr="true">QComboBox {
    background-color: #E59D25;   /* Fond citrine doré */
    color: #2E4365;               /* Texte bleu foncé */
    border-radius: 8px;
    padding: 5px 15px;
    font-weight: bold;
}

QComboBox:hover {
    background-color: #D48A1F;   /* Plus foncé au survol */
}

QComboBox:pressed {
    background-color: #B37319;   /* Plus foncé quand pressé */
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-left: none;
}

QComboBox QAbstractItemView {
    background-color: #E59D25;   /* Fond de la liste */
    color: #2E4365;               /* Texte des items */
    selection-background-color: #D48A1F; /* Item sélectionné */
    selection-color: #2E4365;
}
</string>
